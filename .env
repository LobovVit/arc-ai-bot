TELEGRAM_BOT_TOKEN=

# LLM (для Task3 можно оставить stub; для Task4 подключить OpenAI/YandexGPT)
LLM_PROVIDER=stub   # openai | yandex | stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local embeddings service
EMBEDDINGS_URL=http://embeddings:8088
LOCAL_EMB_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_base

# Docs + chunking
DOCS_PATH=/app/data/docs
CHUNK_SIZE=1200
CHUNK_OVERLAP=50
TOP_K=5

ALWAYS_CITE_SOURCES=true
MIN_CONTEXT_CHARS=200

MIN_SCORE=0.45
