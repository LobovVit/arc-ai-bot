# Telegram
TELEGRAM_BOT_TOKEN=

# LLM (YandexGPT by default; falls back to stub if creds missing)
LLM_PROVIDER=yandexgpt

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
# If empty, will be derived as: gpt://<folder_ID>/yandexgpt/latest
YANDEX_MODEL=
# "Bearer" is used in OpenAI-compat examples; "Api-Key" also exists in auth docs
YANDEX_AUTH_SCHEME=Bearer

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings (local service)
EMBEDDINGS_PROVIDER=local_http
EMBEDDINGS_URL=http://embeddings:8088

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_base

# Documents / chunking
DOCS_PATH=/app/data/docs
CHUNK_SIZE=1200
CHUNK_OVERLAP=50
TOP_K=5

# RAG guardrails
ALWAYS_CITE_SOURCES=true
MIN_CONTEXT_CHARS=200
MIN_SCORE=0.45
FEWSHOT_PATH=./prompts/fewshot_ru.md
